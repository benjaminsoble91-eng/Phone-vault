#!/bin/bash
# Stand-in: ideviceinfo -u UDID -x [-q DOMAIN]
udid="$2"; domain=""
[ "$4" = "-q" ] && domain="$5"
if [ "$udid" = "5b98f05085af366b6c9d6ef44537011a30aa4a33" ]; then
  echo "ERROR: Could not connect to lockdownd: Pairing dialog response pending (-19)" >&2; exit 255
fi
h='<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict>'
case "$domain" in
  "") echo "$h<key>DeviceName</key><string>iPhone 12 mini</string><key>ProductType</key><string>iPhone13,1</string><key>ProductVersion</key><string>26.5.2</string><key>DeviceClass</key><string>iPhone</string><key>SerialNumber</key><string>F17DK3XYQ0F1</string><key>BuildVersion</key><string>23F79</string></dict></plist>";;
  com.apple.mobile.battery) echo "$h<key>BatteryCurrentCapacity</key><integer>81</integer><key>BatteryIsCharging</key><true/></dict></plist>";;
  com.apple.disk_usage) echo "$h<key>TotalDiskCapacity</key><integer>128000000000</integer><key>AmountDataAvailable</key><integer>41500000000</integer></dict></plist>";;
  com.apple.mobile.backup) echo "$h<key>WillEncrypt</key><false/></dict></plist>";;
  com.apple.fmip) echo "$h<key>IsAssociated</key><false/></dict></plist>";;
esac
